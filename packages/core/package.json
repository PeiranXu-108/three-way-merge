{
  "name": "three-way-diff-editor",
  "version": "0.1.1",
  "description": "Three-column diff editor with merge controls.",
  "license": "MIT",
  "author": "ryanxu",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/index.css"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "diff": "^5.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "node scripts/generate-styles.js && tsup src/index.ts --format esm,cjs --dts && node scripts/copy-css.js",
    "dev": "node scripts/generate-styles.js && tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  }
}
